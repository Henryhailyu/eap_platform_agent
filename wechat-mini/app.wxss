page {
  background: #f5f5f7;
  color: #1d1d1f;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;
  font-size: 30rpx;
  line-height: 1.45;
}

.container {
  padding: 32rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.06);
}

.btn-primary {
  background: #0071e3;
  color: #fff;
  border-radius: 14rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.btn-primary[disabled] {
  background: #a8c8f0;
  color: #fff;
}

.btn-secondary {
  background: #fff;
  color: #0071e3;
  border: 2rpx solid #0071e3;
  border-radius: 14rpx;
}

.muted {
  color: #6e6e73;
  font-size: 26rpx;
}

.badge {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  background: rgba(10, 126, 164, 0.12);
  color: #0a7ea4;
}

.text-error {
  color: #d70015;
  font-size: 26rpx;
  margin-top: 12rpx;
}

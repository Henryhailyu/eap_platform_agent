<view class="container">
  <text class="date-title">{{date}}</text>
  <text class="muted class-line">{{className}}</text>

  <view class="card" wx:if="{{loading}}">
    <text class="muted">{{L.loading}}</text>
  </view>

  <view class="card" wx:elif="{{error}}">
    <text class="text-error">{{error}}</text>
  </view>

  <view wx:elif="{{tasks.length === 0}}" class="card">
    <text class="muted">{{L.no_tasks_day}}</text>
  </view>

  <block wx:else>
    <view
      class="card task-row"
      wx:for="{{tasks}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="openTask"
    >
      <view class="row-top">
        <text class="task-title">{{item.title}}</text>
        <text class="badge" wx:if="{{item.completion.completed}}">{{L.completed}}</text>
        <text class="badge pending" wx:else>{{L.pending}}</text>
      </view>
      <text class="muted" wx:if="{{item.category}}">{{item.category}}</text>
    </view>
  </block>
</view>

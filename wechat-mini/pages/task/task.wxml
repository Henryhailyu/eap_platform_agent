<view class="container" wx:if="{{task}}">
  <view class="card">
    <text class="task-title">{{task.title}}</text>
    <text class="badge" wx:if="{{task.category}}">{{task.category}}</text>
    <text class="muted block">{{task.date}} · {{className}}</text>
    <text class="desc" wx:if="{{task.description}}">{{task.description}}</text>
    <button class="btn-secondary file-btn" wx:if="{{task.file_path}}" bindtap="openMaterial">{{L.open_material}}</button>
  </view>

  <view class="card">
    <text class="section-title">{{L.completion}}</text>
    <text class="muted">{{completion.status || 'Pending'}}</text>
    <button class="btn-secondary toggle" bindtap="toggleComplete">
      {{completion.completed ? L.mark_pending : L.mark_completed}}
    </button>
  </view>

  <view class="card" wx:if="{{submission}}">
    <text class="section-title">{{L.your_submission}}</text>
    <text class="muted">{{submission.status}}</text>
    <text class="block" wx:if="{{submission.answer_text}}">{{submission.answer_text}}</text>
    <button class="btn-secondary file-btn" wx:if="{{submission.file_path}}" bindtap="openSubmissionFile">{{L.open_file}}</button>
    <text class="feedback" wx:if="{{submission.teacher_feedback}}">{{L.feedback}}: {{submission.teacher_feedback}}</text>
  </view>

  <view class="card" wx:if="{{!submission}}">
    <text class="section-title">{{L.submit_homework}}</text>
    <textarea class="textarea" placeholder="{{L.answer_placeholder}}" value="{{answerText}}" bindinput="onAnswer" />
    <button class="btn-secondary pick" bindtap="pickFile">{{fileName || L.choose_file}}</button>
    <button class="btn-primary submit" loading="{{submitting}}" bindtap="onSubmit">{{L.submit}}</button>
  </view>

  <view class="card" wx:if="{{submission && submission.teacher_feedback}}">
    <text class="section-title">{{L.revision}}</text>
    <textarea class="textarea" placeholder="{{L.revision_placeholder}}" value="{{revisionText}}" bindinput="onRevision" />
    <button class="btn-secondary pick" bindtap="pickRevisionFile">{{revisionFileName || L.choose_file}}</button>
    <button class="btn-primary submit" loading="{{submitting}}" bindtap="onRevision">{{L.send_revision}}</button>
  </view>

  <text class="text-error" wx:if="{{error}}">{{error}}</text>
</view>

<view class="container" wx:else>
  <view class="card"><text class="muted">{{loading ? L.loading : error}}</text></view>
</view>

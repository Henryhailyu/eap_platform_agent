.task-title {
  font-size: 36rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 12rpx;
}

.block {
  display: block;
  margin-top: 12rpx;
}

.desc {
  display: block;
  margin-top: 20rpx;
  white-space: pre-wrap;
}

.section-title {
  font-weight: 600;
  display: block;
  margin-bottom: 12rpx;
}

.textarea {
  width: 100%;
  min-height: 160rpx;
  background: #f5f5f7;
  border-radius: 12rpx;
  padding: 20rpx;
  box-sizing: border-box;
  margin: 16rpx 0;
}

.pick,
.toggle,
.submit {
  margin-top: 16rpx;
}

.header-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.class-label {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #0071e3;
}

.week-hint {
  display: block;
  margin-top: 6rpx;
}

.calendar-sub {
  display: block;
  margin-top: 8rpx;
}

.header-actions {
  text-align: right;
  flex-shrink: 0;
}

.header-actions .link {
  display: block;
  color: #0071e3;
  font-size: 26rpx;
  margin-bottom: 8rpx;
}

.month-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav-btn {
  font-size: 44rpx;
  color: #0071e3;
  padding: 0 24rpx;
}

.month-title {
  font-size: 32rpx;
  font-weight: 600;
}

.weekdays {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  margin-bottom: 8rpx;
}

.wd {
  text-align: center;
  font-size: 22rpx;
  color: #6e6e73;
}

.days {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
}

.day-cell {
  aspect-ratio: 1;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f5f5f7;
}

.day-cell.other {
  opacity: 0.35;
}

.day-cell.today {
  background: rgba(0, 113, 227, 0.12);
}

.day-cell.holiday {
  background: rgba(10, 126, 164, 0.1);
}

.day-num {
  font-size: 26rpx;
}

.dot {
  font-size: 20rpx;
  color: #0a7ea4;
  margin-top: 4rpx;
}

.holiday-dot {
  font-size: 18rpx;
  color: #0a7ea4;
}

.retry {
  margin-top: 20rpx;
}

<view class="container">
  <view class="header-row">
    <view class="header-main">
      <text class="class-label" bindtap="onPickClass">{{className}} ▾</text>
      <text class="muted">{{userName}}</text>
      <text class="week-hint muted" wx:if="{{weekHint}}">{{weekHint}}</text>
    </view>
    <view class="header-actions">
      <text class="link" bindtap="onToggleLang">{{L.lang_toggle}}</text>
      <text class="link" bindtap="goArchive">{{L.archive}}</text>
      <text class="link" bindtap="onLogout">{{L.logout}}</text>
    </view>
  </view>

  <view class="card month-nav">
    <text class="nav-btn" bindtap="prevMonth">‹</text>
    <text class="month-title">{{monthLabel}}</text>
    <text class="nav-btn" bindtap="nextMonth">›</text>
  </view>

  <view class="card" wx:if="{{loading}}">
    <text class="muted">{{L.loading_tasks}}</text>
  </view>

  <view class="card" wx:elif="{{error}}">
    <text class="text-error">{{error}}</text>
    <button class="btn-secondary retry" bindtap="loadTasks">{{L.retry}}</button>
  </view>

  <view class="card calendar-grid" wx:else>
    <view class="weekdays">
      <text wx:for="{{weekdays}}" wx:key="*this" class="wd">{{item}}</text>
    </view>
    <view class="days">
      <view
        wx:for="{{cells}}"
        wx:key="date"
        class="day-cell {{item.inMonth ? '' : 'other'}} {{item.isToday ? 'today' : ''}} {{item.isHoliday ? 'holiday' : ''}}"
        data-date="{{item.date}}"
        bindtap="onDayTap"
      >
        <text class="day-num">{{item.day}}</text>
        <text class="dot" wx:if="{{item.count > 0}}">{{item.count}}</text>
        <text class="holiday-dot" wx:if="{{item.holidayLabel}}">·</text>
      </view>
    </view>
  </view>
</view>

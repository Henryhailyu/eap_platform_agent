.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.brand {
  margin-bottom: 48rpx;
}

.brand-title {
  display: block;
  font-size: 44rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.field {
  margin-bottom: 28rpx;
}

.label {
  display: block;
  font-size: 26rpx;
  color: #6e6e73;
  margin-bottom: 10rpx;
}

.input {
  background: #f5f5f7;
  border-radius: 12rpx;
  padding: 22rpx 24rpx;
}

.login-btn {
  margin-top: 16rpx;
}

.foot {
  text-align: center;
  margin-top: 40rpx;
  display: block;
}

.top-bar {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 24rpx;
}

.lang-toggle {
  color: #0071e3;
  font-size: 28rpx;
  padding: 8rpx 16rpx;
}

.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.brand {
  margin-bottom: 48rpx;
}

.brand-title {
  display: block;
  font-size: 44rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.field {
  margin-bottom: 28rpx;
}

.label {
  display: block;
  font-size: 26rpx;
  color: #6e6e73;
  margin-bottom: 10rpx;
}

.input {
  background: #f5f5f7;
  border-radius: 12rpx;
  padding: 22rpx 24rpx;
}

.login-btn {
  margin-top: 16rpx;
}

.legal-footer {
  margin-top: 28rpx;
  text-align: center;
}

.legal-muted {
  display: block;
  font-size: 22rpx;
  color: #86868b;
  margin-bottom: 8rpx;
}

.legal-links {
  font-size: 24rpx;
}

.legal-link {
  color: #0071e3;
}

.legal-sep {
  color: #86868b;
}

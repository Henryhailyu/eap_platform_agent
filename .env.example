# Copy to backend/.env or export in your host dashboard (never commit real .env).

# --- Environment ---
EAP_ENV=development
# EAP_ENV=production
# EAP_PILOT_MODE=1
# EAP_PRODUCTION_PRESET=1
# EAP_PUBLIC_URL=https://your-app.onrender.com
# Lighthouse after ICP: EAP_PUBLIC_URL=https://elc-eap-platform.top

# --- Required for production ---
# EAP_SECRET_KEY=replace-with-long-random-string

# --- Server ---
PORT=5051
# EAP_HOST=0.0.0.0

# --- Security (recommended ON for any public pilot) ---
EAP_REQUIRE_SESSION_IDENTITY=1
EAP_ENFORCE_MEMBERSHIP=1
# EAP_SESSION_COOKIE_SECURE=1
# EAP_SESSION_COOKIE_SAMESITE=Lax
# EAP_TRUST_PROXY=1

# --- CORS (comma-separated; include your public site origin) ---
# EAP_CORS_ORIGINS=https://your-school.example,http://127.0.0.1:5051

# --- Database (SQLite for pilot; PostgreSQL in Phase G) ---
# EAP_DATABASE_PATH=/var/lib/eap/eap_platform.db
# EAP_DATABASE_URL=postgresql://user:pass@host:5432/eap

# --- File storage (persistent volumes on cloud hosts) ---
# EAP_UPLOAD_DIR=/var/lib/eap/uploads
# EAP_SUBMISSIONS_DIR=/var/lib/eap/submissions

# --- Logging ---
# EAP_LOG_LEVEL=INFO
# EAP_ACCESS_LOG=1

# --- Pilot deploy (Docker / Render) ---
# EAP_SEED_PILOT=1

# --- Phase K AI (optional — never commit real keys; see docs/API_KEYS_AND_SECRETS.md) ---
# EAP_AI_ENABLED=1
# EAP_AI_PROVIDER=deepseek
#
# EAP_DEEPSEEK_API_KEY=sk-your-deepseek-key
# EAP_DEEPSEEK_BASE_URL=https://api.deepseek.com
# EAP_DEEPSEEK_MODEL=deepseek-chat
#
# EAP_OPENAI_API_KEY=sk-your-proxy-key
# EAP_OPENAI_BASE_URL=https://api.gptsapi.net/v1
# EAP_OPENAI_MODEL=gpt-4o-mini
#
# Tencent Hunyuan (OpenAI-compatible) — use on Lighthouse Docker:
# EAP_AI_PROVIDER=openai
# EAP_OPENAI_API_KEY=sk-your-hunyuan-key
# EAP_OPENAI_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
# EAP_OPENAI_MODEL=hunyuan-turbos-latest
# EAP_SEED_DEMO_TASKS=1
# EAP_PILOT_DEFAULT_PASSWORD=choose-a-strong-password
# GUNICORN_WORKERS=2

# --- Phase I2a: Bearer tokens for mini-program / mobile API ---
# EAP_TOKEN_TTL_SECONDS=604800

# --- SS-Sp4 Tencent audio (TTS / ASR / SOE / COS) — see docs/SS-Sp4_TENCENT_PROCUREMENT_CHECKLIST.md ---
# EAP_AUDIO_ENABLED=1
# EAP_TENCENT_SECRET_ID=AKIDxxxxxxxx
# EAP_TENCENT_SECRET_KEY=xxxxxxxx
# EAP_TENCENT_APP_ID=1300000000
# EAP_TENCENT_REGION=ap-shanghai
# EAP_COS_BUCKET=eap-pilot-audio-1300000000
# EAP_COS_REGION=ap-shanghai
# EAP_COS_AUDIO_PREFIX=self-study/
# EAP_TTS_ENABLED=1
# EAP_TTS_VOICE_ID=101051
# EAP_ASR_ENABLED=1
# EAP_ASR_ENGINE=16k_en
# EAP_SOE_ENABLED=1
# EAP_SOE_APP_ID=1300000000
# EAP_SOE_ENGINE=16k_en
# EAP_SPEAKING_AUDIO_RETENTION_DAYS=90

# --- Phase N Tencent VOD (recorded lessons) — see docs/TENCENT_VOD_SETUP.md ---
# EAP_VOD_ENABLED=1
# EAP_VOD_APP_ID=1300000000
# EAP_VOD_SUB_APP_ID=
# EAP_VOD_REGION=ap-shanghai
# EAP_VOD_PLAY_KEY=your-vod-anti-hotlink-key
# EAP_VOD_CALLBACK_KEY=your-vod-event-callback-key
# EAP_VOD_PLAY_TTL_SECONDS=7200
# EAP_VOD_TRANSCODE_TEMPLATE_ID=10
